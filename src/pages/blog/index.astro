---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/cms';

import es from '../../data/jsons/locales/es.json';

const t = es;
const { items } = await getPosts('blog', 'es', { limit: 50 });
---

<BaseLayout
  title="Blog — HieysoN | Guías de software, IA y automatización"
  description="Guías y tutoriales de desarrollo de software, agentes de IA y automatización con n8n."
  lang="es"
  canonicalURL="https://hieyson.com/blog"
>
  <div class="relative z-10 flex flex-col min-h-screen">
    <Header t={t} />

    <main class="flex-grow pt-36 pb-24">
      <div class="max-w-7xl mx-auto px-6 lg:px-12">
        <span class="text-xs font-mono tracking-[0.2em] text-light-muted dark:text-dark-muted uppercase mb-4 block">{t['blog.num']}</span>
        <h1 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tighter text-light-accent dark:text-white mb-6">{t['blog.title']}</h1>
        <p class="text-gray-600 dark:text-gray-400 font-light max-w-xl text-sm mb-10">{t['blog.desc']}</p>

        {items.length > 0 ? (
          <>
            <div class="relative max-w-md mb-12">
              <input id="post-search" type="search" placeholder={t['blog.search_ph']}
                class="w-full bg-transparent border border-light-border dark:border-dark-border px-5 py-3 text-sm font-mono text-light-accent dark:text-white placeholder:text-light-muted dark:placeholder:text-dark-muted focus:outline-none focus:border-light-accent dark:focus:border-white transition-colors" />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-light-border dark:bg-dark-border border border-light-border dark:border-dark-border" id="posts-grid">
              {items.map((post) => (
                <PostCard post={post} lang="es" base="/blog" />
              ))}
            </div>
            <p id="posts-empty" class="hidden font-mono text-sm text-light-muted dark:text-dark-muted py-16 text-center">{t['blog.empty']}</p>
          </>
        ) : (
          <p class="font-mono text-sm text-light-muted dark:text-dark-muted py-16">{t['blog.empty']}</p>
        )}
      </div>
    </main>

    <Footer t={t} />
  </div>
</BaseLayout>

<script>
  const input = document.getElementById('post-search') as HTMLInputElement | null;
  const cards = Array.from(document.querySelectorAll('.post-card'));
  const empty = document.getElementById('posts-empty');
  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    cards.forEach((card) => {
      const hay = (card.getAttribute('data-search') ?? '').includes(q);
      card.classList.toggle('hidden', !hay);
      if (hay) visible++;
    });
    empty?.classList.toggle('hidden', visible > 0);
  });
</script>
