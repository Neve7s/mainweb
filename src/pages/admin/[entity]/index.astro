---
export const prerender = false;

import AdminLayout from '../../../components/AdminLayout.astro';
import { apiFetch, btnCls, btnPrimaryCls, requireAdmin } from '../../../lib/admin';
import { ENTITIES } from '../../../lib/admin-entities';

const { entity } = Astro.params;
const cfg = entity ? ENTITIES[entity] : undefined;
if (!cfg) return Astro.redirect('/admin');
const me = await requireAdmin(Astro);
if (!me) return Astro.redirect('/admin/login');

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = String(fd.get('_action') ?? '');
  const id = String(fd.get('id') ?? '');
  if (id && (action === 'delete' || action === 'toggle')) {
    if (action === 'delete') {
      await apiFetch(Astro, `${cfg.apiBase}/${encodeURIComponent(id)}`, { method: 'DELETE' });
    } else {
      await apiFetch(Astro, `${cfg.apiBase}/${encodeURIComponent(id)}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ published: fd.get('to') === 'true' }),
      });
    }
  }
  return Astro.redirect(`/admin/${cfg.key}`);
}

const listPath =
  cfg.apiBase + (cfg.fixed?.type ? `?type=${cfg.fixed.type}&limit=200` : '');
const r = await apiFetch(Astro, listPath);
const rows: any[] = r.ok ? await r.json() : [];
---

<AdminLayout title={cfg.title} email={me.email}>
  <div class="flex items-center justify-between mb-8">
    <p class="font-mono text-xs text-light-muted dark:text-dark-muted">{rows.length} registros</p>
    <a href={`/admin/${cfg.key}/nuevo`} class={btnPrimaryCls}>+ Nuevo</a>
  </div>

  <div class="border border-light-border dark:border-dark-border overflow-x-auto">
    <table class="w-full text-left">
      <thead>
        <tr class="border-b border-light-border dark:border-dark-border font-mono text-[10px] uppercase tracking-[0.15em] text-light-muted dark:text-dark-muted">
          <th class="px-4 py-3 font-normal">Título</th>
          <th class="px-4 py-3 font-normal">Slug / ID</th>
          <th class="px-4 py-3 font-normal">Estado</th>
          <th class="px-4 py-3 font-normal text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-light-border/50 dark:border-dark-border/50 last:border-0">
            <td class="px-4 py-3 text-sm text-light-accent dark:text-white max-w-xs truncate">{cfg.titleOf(row)}</td>
            <td class="px-4 py-3 font-mono text-xs text-light-muted dark:text-dark-muted">{row.slug ?? row.id}</td>
            <td class="px-4 py-3">
              <span class={`font-mono text-[10px] uppercase tracking-wider px-2 py-1 border ${row.published ? 'text-emerald-600 dark:text-emerald-400 border-emerald-500/40' : 'text-light-muted dark:text-dark-muted border-light-border dark:border-dark-border'}`}>
                {row.published ? 'Publicado' : 'Borrador'}
              </span>
            </td>
            <td class="px-4 py-3">
              <div class="flex justify-end gap-2">
                <a href={`/admin/${cfg.key}/${encodeURIComponent(row.id)}`} class={`${btnCls} !px-3 !py-1.5 !text-[10px]`}>Editar</a>
                <form method="POST" class="inline">
                  <input type="hidden" name="_action" value="toggle" />
                  <input type="hidden" name="id" value={row.id} />
                  <input type="hidden" name="to" value={row.published ? 'false' : 'true'} />
                  <button type="submit" class={`${btnCls} !px-3 !py-1.5 !text-[10px]`}>
                    {row.published ? 'Ocultar' : 'Publicar'}
                  </button>
                </form>
                <form method="POST" class="inline" onsubmit="return confirm('¿Borrar? No se puede deshacer.')">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={row.id} />
                  <button type="submit" class="!px-3 !py-1.5 !text-[10px] inline-flex items-center justify-center font-mono uppercase tracking-wider border border-red-500/50 text-red-600 dark:text-red-400 hover:bg-red-600 hover:text-white transition-all">Borrar</button>
                </form>
              </div>
            </td>
          </tr>
        ))}
        {rows.length === 0 && (
          <tr>
            <td colspan="4" class="px-4 py-10 text-center font-mono text-xs text-light-muted dark:text-dark-muted">Sin registros. Crea el primero con “+ Nuevo”.</td>
          </tr>
        )}
      </tbody>
    </table>
  </div>
</AdminLayout>
