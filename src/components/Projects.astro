---
import type { ProjectItem } from '../lib/cms';

interface Props {
  t: Record<string, string>;
  projects: ProjectItem[];
  lang?: 'es' | 'en';
}

const { t, projects, lang = 'es' } = Astro.props;
const allHref = lang === 'en' ? '/en/proyectos' : '/proyectos';
---

<section id="work" class="py-32 border-t border-light-border dark:border-dark-border relative transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-24" data-animate data-scroll-reveal="up">
      <span class="text-xs font-mono tracking-[0.2em] text-light-muted dark:text-dark-muted uppercase mb-4 block transition-colors">{t['work.num']}</span>
      <h2 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tighter text-light-accent dark:text-white transition-colors">
        <span>{t['work.title_1']} </span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-500 to-gray-900 dark:from-gray-400 dark:to-white transition-colors">{t['work.title_2']}</span>
      </h2>
    </div>

    <div id="projects-container" class="space-y-6">
      {projects.map((project, index) => (
        <div class="project-card cursor-pointer" data-project-id={project.id} data-card-index={String(index)}>
          <div class="group relative overflow-hidden border border-light-border dark:border-dark-border bg-dark-900 hover:shadow-2xl transition-all duration-500 glow-on-hover">
            <div class="relative h-64 sm:h-80 overflow-hidden bg-dark-900">
              {project.cover && (
                <img src={project.cover} alt={project.titulo} class="card-img w-full h-full object-cover transition-all duration-700 group-hover:scale-105" loading="lazy" />
              )}
              <div class="card-gradient absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/10"></div>
            </div>
            <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
              <span class="card-cat text-[10px] font-mono tracking-[0.2em] uppercase text-white/70 mb-2 block">{project.categoria}</span>
              <h3 class="card-title text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-white mb-2">{project.titulo}</h3>
              <p class="card-desc text-sm text-white/80 font-light line-clamp-2">{project.descripcion}</p>
              <div class="card-tags mt-4 flex flex-wrap gap-2">
                {(project.stack.length > 0 ? project.stack : [project.tecnologias_listado]).map((tech) => (
                  <span class="text-[10px] font-mono px-2 py-1 border border-white/25 text-white/80 bg-black/40 backdrop-blur-sm">{tech}</span>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="mt-16 flex justify-center" data-animate data-scroll-reveal="up">
      <a href={allHref} class="no-underline group inline-flex items-center gap-3 text-xs font-mono uppercase tracking-[0.2em] text-light-accent dark:text-white border border-light-border dark:border-dark-border px-8 py-4 hover:bg-light-accent hover:text-light-900 dark:hover:bg-white dark:hover:text-black transition-all">
        <span>{t['projects.view_all']}</span>
        <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
      </a>
    </div>
  </div>
</section>

<script>
  // Animación cinematográfica de entrada (las cards ya vienen renderizadas del servidor)
  const container = document.getElementById('projects-container');
  if (container) {
    const cards = container.querySelectorAll('.project-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const idx = parseInt(card.getAttribute('data-card-index') || '0');
          setTimeout(() => {
            card.classList.add('is-visible');
            const img = card.querySelector('.card-img') as HTMLElement | null;
            const gradient = card.querySelector('.card-gradient') as HTMLElement | null;
            const cat = card.querySelector('.card-cat') as HTMLElement | null;
            const title = card.querySelector('.card-title') as HTMLElement | null;
            const desc = card.querySelector('.card-desc') as HTMLElement | null;
            const tags = card.querySelector('.card-tags') as HTMLElement | null;
            if (img) { img.style.transitionDelay = '0ms'; img.classList.add('build-in'); }
            if (gradient) { gradient.style.transitionDelay = '200ms'; gradient.classList.add('build-in'); }
            if (cat) { cat.style.transitionDelay = '250ms'; cat.classList.add('build-slide-left'); }
            if (title) { title.style.transitionDelay = '350ms'; title.classList.add('build-slide-left'); }
            if (desc) { desc.style.transitionDelay = '450ms'; desc.classList.add('build-slide-left'); }
            if (tags) { tags.style.transitionDelay = '550ms'; tags.classList.add('build-slide-right'); }
          }, idx * 120);
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });

    cards.forEach(card => observer.observe(card));
  }
</script>
