---
const t = Astro.props.t;
---

<section id="work" class="py-32 border-t border-light-border dark:border-dark-border relative transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="mb-24" data-animate data-scroll-reveal="up">
      <span class="text-xs font-mono tracking-[0.2em] text-light-muted dark:text-dark-muted uppercase mb-4 block transition-colors">{t['work.num']}</span>
      <h2 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tighter text-light-accent dark:text-white transition-colors">
        <span>{t['work.title_1']} </span>
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-gray-500 to-gray-900 dark:from-gray-400 dark:to-white transition-colors">{t['work.title_2']}</span>
      </h2>
    </div>

    <div id="projects-container" class="space-y-6">
      <!-- Projects loaded client-side -->
    </div>
  </div>
</section>

<script>
  import projectsData from '../data/jsons/Proyectos.json';

  const container = document.getElementById('projects-container');
  if (container) {
    const projects = projectsData.proyectos || [];
    
    projects.forEach((project: any, index: number) => {
      const firstImg = project.imagenes && project.imagenes.length > 0 ? '/' + project.imagenes[0] : '';
      const card = document.createElement('div');
      card.className = 'project-card cursor-pointer';
      card.setAttribute('data-project-id', project.id);
      card.setAttribute('data-card-index', String(index));
      card.innerHTML = `
        <div class="group relative overflow-hidden border border-light-border dark:border-dark-border bg-white dark:bg-dark-900 hover:shadow-2xl transition-all duration-500 glow-on-hover">
          <div class="relative h-64 sm:h-80 overflow-hidden bg-white dark:bg-dark-900">
            ${firstImg ? `<img src="${firstImg}" alt="${project.titulo_listado}" class="card-img w-full h-full object-cover transition-all duration-700 group-hover:scale-105" loading="lazy" />` : ''}
            <div class="card-gradient absolute inset-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent dark:from-black dark:via-black/50 dark:to-transparent"></div>
            <div class="card-overlay absolute inset-0 bg-white/50 dark:bg-transparent transition-opacity duration-500 group-hover:opacity-0 pointer-events-none"></div>
          </div>
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8">
            <span class="card-cat text-[10px] font-mono tracking-[0.2em] uppercase text-black/70 dark:text-white/80 mb-2 block" style="text-shadow: 0 1px 4px rgba(255,255,255,0.6)">${project.categoria || ''}</span>
            <h3 class="card-title text-xl sm:text-2xl font-display font-bold uppercase tracking-tight text-black dark:text-white mb-2" style="text-shadow: 0 1px 6px rgba(255,255,255,0.5)">${project.titulo_listado || ''}</h3>
            <p class="card-desc text-sm text-black/80 dark:text-white/90 font-light line-clamp-2" style="text-shadow: 0 1px 4px rgba(255,255,255,0.4)">${project.descripcion_listado || ''}</p>
            <div class="card-tags mt-4 flex flex-wrap gap-2">
              ${(project.tecnologias_listado || '').split(',').map((tech: string) => 
                `<span class="text-[10px] font-mono px-2 py-1 border border-black/20 dark:border-white/30 text-black/70 dark:text-white/80 bg-white/40 dark:bg-black/30 backdrop-blur-sm">${tech.trim()}</span>`
              ).join('')}
            </div>
          </div>
        </div>
      `;
      container.appendChild(card);
    });

    // Cinematic scroll-triggered construction
    const cards = container.querySelectorAll('.project-card');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const card = entry.target as HTMLElement;
          const idx = parseInt(card.getAttribute('data-card-index') || '0');
          const delay = idx * 120;

          setTimeout(() => {
            card.classList.add('is-visible');

            const img = card.querySelector('.card-img') as HTMLElement;
            const gradient = card.querySelector('.card-gradient') as HTMLElement;
            const overlay = card.querySelector('.card-overlay') as HTMLElement;
            const cat = card.querySelector('.card-cat') as HTMLElement;
            const title = card.querySelector('.card-title') as HTMLElement;
            const desc = card.querySelector('.card-desc') as HTMLElement;
            const tags = card.querySelector('.card-tags') as HTMLElement;

            if (img) { img.style.transitionDelay = '0ms'; img.classList.add('build-in'); }
            if (gradient) { gradient.style.transitionDelay = '200ms'; gradient.classList.add('build-in'); }
            if (overlay) { overlay.style.transitionDelay = '300ms'; overlay.classList.add('build-in'); }
            if (cat) { cat.style.transitionDelay = '250ms'; cat.classList.add('build-slide-left'); }
            if (title) { title.style.transitionDelay = '350ms'; title.classList.add('build-slide-left'); }
            if (desc) { desc.style.transitionDelay = '450ms'; desc.classList.add('build-slide-left'); }
            if (tags) { tags.style.transitionDelay = '550ms'; tags.classList.add('build-slide-right'); }
          }, delay);

          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -30px 0px' });
    
    cards.forEach(card => observer.observe(card));
  }
</script>
