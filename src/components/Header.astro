---
import { getSettings } from '../lib/cms';
const t = Astro.props.t;
// Marca y contacto 100% desde Postgres (fallback a site.json si la API cae).
const settings = await getSettings();
const brand = (settings['brand'] ?? {}) as { name?: string; logo_dark?: string; logo_light?: string };
const brandName = brand.name || 'HieysoN';
const logoDark = brand.logo_dark || '/img/logo/white/favicon-96x96.png';
const logoLight = brand.logo_light || '/img/logo/black/favicon-96x96.png';
const contact = (settings['contact'] ?? {}) as { email?: string; phoneDisplay?: string; whatsappUrl?: string };
const socialNetworks = ((settings['social'] ?? []) as Array<{ key: string; name: string; url: string; svg?: string; enabled?: boolean }>)
  .filter((s) => s && s.enabled !== false && s.url && s.url !== '#');
const sizedSvg = (svg: string, cls: string) => (svg || '').replace(/class="[^"]*"/, `class="${cls}"`);

const pathname = Astro.url.pathname;
const isEN = pathname.startsWith('/en');
const path = pathname.replace(/^\/en/, '') || '/';
// Cambio de idioma conservando la página (incluye slugs).
const otherLangPath = isEN ? path : `/en${path === '/' ? '/' : path}`;

const links = [
  { href: isEN ? '/en/' : '/', active: path === '/', label: t['nav.home'] },
  { href: isEN ? '/en/servicios' : '/servicios', active: path.startsWith('/servicios'), label: t['nav.expertise'] },
  { href: isEN ? '/en/proyectos' : '/proyectos', active: path.startsWith('/proyectos'), label: t['nav.work'] },
  { href: isEN ? '/en/blog' : '/blog', active: path.startsWith('/blog'), label: t['nav.blog'] },
  { href: isEN ? '/en/noticias' : '/noticias', active: path.startsWith('/noticias'), label: t['nav.news'] },
];

const linkCls = (active: boolean) =>
  `nav-link no-underline text-xs tracking-[0.1em] uppercase transition-colors py-2 border-b ${active
    ? 'text-light-accent dark:text-white border-light-accent dark:border-white'
    : 'text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white border-transparent'}`;

const mobileLinkCls = (active: boolean) =>
  `no-underline text-xs tracking-[0.2em] uppercase pb-4 border-b transition-colors flex items-center justify-between group ${active
    ? 'text-light-accent dark:text-white border-light-accent/60 dark:border-white/60'
    : 'text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white border-light-border/50 dark:border-dark-border/50'}`;
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 pointer-events-none" id="navbar">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 pointer-events-auto">
    <div class="flex justify-between items-center h-24 border-b border-light-border/0 dark:border-dark-border/0 transition-colors duration-300" id="nav-border">
      <!-- Brand -->
      <a href={isEN ? '/en/' : '/'} class="no-underline flex-shrink-0 cursor-pointer flex items-center gap-3 h-full" aria-label={brandName}>
        <img id="brand-logo" src={logoDark} data-live-logo="true" data-logo-dark={logoDark} data-logo-light={logoLight} alt={`${brandName} Logo`} class="h-8 md:h-10 w-auto opacity-90 hover:opacity-100 transition-opacity">
        <span data-live="brand.name" class="text-sm md:text-base font-display font-bold tracking-[0.15em] uppercase text-light-accent dark:text-white transition-colors">{brandName}</span>
      </a>

      <!-- Desktop Nav -->
      <nav class="hidden md:flex space-x-8 lg:space-x-10 items-center" aria-label="Principal">
        {links.map((l) => (
          <a href={l.href} class={linkCls(l.active)} {...(l.active ? { 'aria-current': 'page' } : {})}>{l.label}</a>
        ))}

        <!-- Theme Toggle & Lang Toggle -->
        <div class="flex items-center space-x-6 border-l border-light-border dark:border-dark-border pl-6 ml-2 h-8">
          <button id="theme-toggle" type="button" class="text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white focus:outline-none focus:ring-0 border-0 bg-transparent p-0 transition-colors" aria-label="Theme">
            <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
          </button>
          <a href={otherLangPath} class="no-underline text-[10px] font-mono tracking-widest uppercase text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white focus:outline-none transition-colors">
            {isEN ? 'ES' : 'EN'}
          </a>
        </div>

        <div class="relative overflow-hidden inline-flex">
          <canvas class="spark-btn-canvas absolute inset-0 w-full h-full pointer-events-none z-10"></canvas>
          <a href="#contact" class="relative z-20 no-underline text-xs uppercase tracking-[0.1em] font-mono border border-light-border dark:border-dark-border px-6 py-3 hover:bg-light-accent hover:text-light-900 dark:hover:bg-white dark:hover:text-black transition-all bg-transparent">{t['nav.contact']}</a>
        </div>
      </nav>

      <!-- Mobile Toggle -->
      <div class="md:hidden flex items-center gap-6">
        <button id="theme-toggle-mobile" type="button" class="text-light-accent dark:text-white focus:outline-none focus:ring-0 border-0 bg-transparent p-0 transition-colors" aria-label="Theme">
          <svg id="theme-toggle-light-icon-mobile" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
          <svg id="theme-toggle-dark-icon-mobile" class="hidden w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
        </button>
        <button id="mobile-btn" class="text-light-accent dark:text-white focus:outline-none focus:ring-0 border-0 bg-transparent p-0 transition-colors" aria-expanded="false" aria-controls="mobile-menu" aria-label="Menu">
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-light-900 dark:bg-dark-900 absolute w-full left-0 py-10 px-8 flex flex-col space-y-8 border-b border-light-border dark:border-dark-border pointer-events-auto transition-all duration-500 z-[90] shadow-2xl">
    <nav class="flex flex-col space-y-5" aria-label="Móvil">
      {links.map((l) => (
        <a href={l.href} class={mobileLinkCls(l.active)} {...(l.active ? { 'aria-current': 'page' } : {})}>
          <span>{l.label}</span>
          <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      ))}
      <a href="#contact" class={mobileLinkCls(false)}>
        <span>{t['nav.contact']}</span>
        <svg class="w-4 h-4 opacity-50 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
      </a>
    </nav>

    <!-- Contact & Brand Info -->
    <div class="flex flex-col space-y-4 pt-4 border-t border-light-border/30 dark:border-dark-border/30">
      <span class="text-[9px] font-mono tracking-[0.3em] uppercase text-light-muted dark:text-dark-muted">Contacto</span>
      <div class="space-y-3 font-mono text-[11px] text-light-accent dark:text-gray-300">
        <a href={`mailto:${contact.email}`} class="no-underline flex items-center gap-3 hover:text-light-accent dark:hover:text-white transition-colors">
          <svg class="w-4 h-4 text-light-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          <span>{contact.email}</span>
        </a>
        <a href={contact.whatsappUrl} class="no-underline flex items-center gap-3 hover:text-light-accent dark:hover:text-white transition-colors">
          <svg class="w-4 h-4 text-light-muted dark:text-dark-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          <span>{contact.phoneDisplay}</span>
        </a>
      </div>
    </div>

    <!-- Social Links -->
    <div class="flex items-center justify-between pt-6 border-t border-light-border/30 dark:border-dark-border/30">
      <span class="text-[9px] font-mono tracking-[0.2em] uppercase text-light-muted dark:text-dark-muted">Social</span>
      <div class="flex gap-5 flex-wrap justify-end">
        {socialNetworks.map(network => (
          <a href={network.url} class="no-underline text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white transition-colors" title={network.name} set:html={sizedSvg(network.svg ?? '', 'w-4 h-4 fill-current')} />
        ))}
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile menu toggle (con aria-expanded + cierre con Escape)
  const mobileBtn = document.getElementById('mobile-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  function setMenu(open) {
    mobileMenu?.classList.toggle('hidden', !open);
    mobileBtn?.setAttribute('aria-expanded', open ? 'true' : 'false');
  }

  mobileBtn?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? false);
  });

  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMenu(false);
      mobileBtn?.focus();
    }
  });

  // Navbar scroll effect (throttled with rAF)
  const navbar = document.getElementById('navbar');
  let navTicking = false;
  window.addEventListener('scroll', () => {
    if (navTicking) return;
    navTicking = true;
    requestAnimationFrame(() => {
      if (window.scrollY > 20) {
        navbar?.classList.add('scrolled');
      } else {
        navbar?.classList.remove('scrolled');
      }
      navTicking = false;
    });
  }, { passive: true });

  // Theme toggle
  function updateThemeIcons() {
    const isDark = document.documentElement.classList.contains('dark');
    const lightIcon = document.getElementById('theme-toggle-light-icon');
    const darkIcon = document.getElementById('theme-toggle-dark-icon');
    const lightIconMobile = document.getElementById('theme-toggle-light-icon-mobile');
    const darkIconMobile = document.getElementById('theme-toggle-dark-icon-mobile');

    if (isDark) {
      darkIcon?.classList.add('hidden');
      lightIcon?.classList.remove('hidden');
      darkIconMobile?.classList.add('hidden');
      lightIconMobile?.classList.remove('hidden');
    } else {
      lightIcon?.classList.add('hidden');
      darkIcon?.classList.remove('hidden');
      lightIconMobile?.classList.add('hidden');
      darkIconMobile?.classList.remove('hidden');
    }
  }

  function toggleTheme() {
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.setItem('color-theme', 'light');
    } else {
      document.documentElement.classList.add('dark');
      localStorage.setItem('color-theme', 'dark');
    }
    updateThemeIcons();
    updateLogo();
  }

  updateThemeIcons();
  document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
  document.getElementById('theme-toggle-mobile')?.addEventListener('click', toggleTheme);

  // Update brand logo based on theme
  function updateLogo() {
    const isDark = document.documentElement.classList.contains('dark');
    const logoImg = document.getElementById('brand-logo') as HTMLImageElement | null;
    if (logoImg) {
      logoImg.src = isDark
        ? logoImg.dataset.logoDark || '/img/logo/white/favicon-96x96.png'
        : logoImg.dataset.logoLight || '/img/logo/black/favicon-96x96.png';
    }
  }
  updateLogo();
</script>
