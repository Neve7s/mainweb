---
const t = Astro.props.t;

const services = [
  { id: 's1', icon: 'terminal', titleKey: 'exp1.title', descKey: 'exp1.desc' },
  { id: 's2', icon: 'bot', titleKey: 'exp2.title', descKey: 'exp2.desc' },
  { id: 's3', icon: 'workflow', titleKey: 'exp3.title', descKey: 'exp3.desc' },
  { id: 's4', icon: 'briefcase', titleKey: 'exp4.title', descKey: 'exp4.desc' },
];

const icons: Record<string, string> = {
  terminal: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />',
  bot: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
  workflow: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />',
  briefcase: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />',
};
---

<section id="expertise" class="py-32 relative border-t border-light-border dark:border-dark-border bg-light-900/50 dark:bg-dark-900/50 backdrop-blur-sm transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-24" data-animate data-scroll-reveal="left">
      <div>
        <span class="text-xs font-mono tracking-[0.2em] text-light-muted dark:text-dark-muted uppercase mb-4 block transition-colors">{t['expertise.num']}</span>
        <h2 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tighter text-light-accent dark:text-white transition-colors">
          <span>{t['expertise.title_1']} </span><br>
          <span class="text-light-muted dark:text-dark-muted transition-colors">{t['expertise.title_2']}</span>
        </h2>
      </div>
      <p class="text-gray-600 dark:text-gray-400 font-light max-w-sm mt-6 md:mt-0 text-sm transition-colors">{t['expertise.desc']}</p>
    </div>

    <!-- Desktop: Grid -->
    <div class="hidden md:grid grid-cols-2 lg:grid-cols-4 gap-px bg-light-border dark:bg-dark-border border border-light-border dark:border-dark-border transition-colors duration-500">
      {services.map((service, idx) => (
        <div data-animate data-scroll-reveal="up" style={`animation-delay: ${idx * 0.1}s`}>
          <div data-service-id={service.id}
            class="h-full bg-light-900 dark:bg-dark-900 p-10 lg:p-12 hover:bg-light-800 dark:hover:bg-dark-800 cursor-pointer hover:z-10 hover:shadow-2xl hover:scale-[1.02] active:scale-[0.99] transition-all duration-300 group glow-on-hover">
            <svg class="w-8 h-8 text-light-accent dark:text-white mb-10 group-hover:scale-110 transition-transform duration-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[service.icon]} />
            <h3 class="text-lg font-mono tracking-tight text-light-accent dark:text-white mb-4 transition-colors">{t[service.titleKey]}</h3>
            <p class="text-sm text-light-muted dark:text-dark-muted font-light leading-relaxed transition-colors">{t[service.descKey]}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- Mobile: Animated Slider -->
    <div class="md:hidden">
      <div id="services-slider" class="flex gap-4 overflow-x-auto snap-x snap-mandatory hide-scrollbar pb-6 -mx-6 px-6">
        {services.map((service, idx) => (
          <div class="service-slide snap-center flex-shrink-0 w-[85vw] max-w-[320px] opacity-0 translate-x-12" style={`transition-delay: ${idx * 120}ms`}>
            <div data-service-id={service.id}
              class="h-full bg-light-900 dark:bg-dark-900 p-8 rounded-2xl border border-light-border/50 dark:border-dark-border/50 hover:bg-light-800 dark:hover:bg-dark-800 cursor-pointer active:scale-[0.98] transition-all duration-300 group glow-on-hover shadow-lg shadow-black/5 dark:shadow-black/20">
              <div class="w-12 h-12 rounded-xl bg-light-800 dark:bg-dark-800 flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500">
                <svg class="w-6 h-6 text-light-accent dark:text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[service.icon]} />
              </div>
              <h3 class="text-base font-mono tracking-tight text-light-accent dark:text-white mb-3 transition-colors">{t[service.titleKey]}</h3>
              <p class="text-sm text-light-muted dark:text-dark-muted font-light leading-relaxed transition-colors">{t[service.descKey]}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Dot indicators -->
      <div class="flex justify-center gap-2 mt-6">
        {services.map((_, idx) => (
          <button
            class={`service-dot w-2 h-2 rounded-full transition-all duration-300 ${idx === 0 ? 'bg-light-accent dark:bg-white w-6' : 'bg-light-border dark:bg-dark-border'}`}
            data-dot-index={idx}
            aria-label={`Servicio ${idx + 1}`}
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initServiceSlider() {
    const slider = document.getElementById('services-slider');
    if (!slider) return;

    const slides = slider.querySelectorAll<HTMLElement>('.service-slide');
    const dots = document.querySelectorAll<HTMLElement>('.service-dot');
    if (!slides.length) return;

    // Entrance animation with IntersectionObserver
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          const slide = entry.target as HTMLElement;
          slide.style.transition = 'opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1), transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
          slide.style.opacity = '1';
          slide.style.transform = 'translateX(0)';
          observer.unobserve(slide);
        }
      });
    }, { threshold: 0.2 });

    slides.forEach(slide => observer.observe(slide));

    // Update dots on scroll
    let scrollTicking = false;
    slider.addEventListener('scroll', () => {
      if (scrollTicking) return;
      scrollTicking = true;
      requestAnimationFrame(() => {
        const scrollLeft = slider.scrollLeft;
        const sliderWidth = slider.scrollWidth - slider.clientWidth;
        const progress = scrollLeft / sliderWidth;
        const activeIndex = Math.round(progress * (slides.length - 1));

        dots.forEach((dot, i) => {
          const el = dot as HTMLElement;
          if (i === activeIndex) {
            el.classList.add('bg-light-accent', 'dark:bg-white', 'w-6');
            el.classList.remove('bg-light-border', 'dark:bg-dark-border');
          } else {
            el.classList.remove('bg-light-accent', 'dark:bg-white', 'w-6');
            el.classList.add('bg-light-border', 'dark:bg-dark-border');
          }
        });

        scrollTicking = false;
      });
    }, { passive: true });

    // Dot click to scroll
    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => {
        const targetScroll = (i / (slides.length - 1)) * (slider.scrollWidth - slider.clientWidth);
        slider.scrollTo({ left: targetScroll, behavior: 'smooth' });
      });
    });
  }

  // Run after DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initServiceSlider);
  } else {
    initServiceSlider();
  }
</script>

<style>
  /* Hide scrollbar on mobile slider */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  /* Snap alignment */
  #services-slider {
    scroll-padding-left: 1.5rem;
    scroll-padding-right: 1.5rem;
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .service-slide {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>
