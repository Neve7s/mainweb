---
interface Props {
  href: string;
  label: string;
  backLabel?: string;
  color?: 'dark' | 'light';
}

const { href, label, backLabel, color = 'dark' } = Astro.props;
---

<a href={href}
  data-cube={color}
  class="group relative inline-flex h-14 min-w-[200px] overflow-hidden"
  style="perspective: 1000px;">
  <span class="cube-inner relative w-full h-full" style="transform-style: preserve-3d; transition: transform 0.6s cubic-bezier(0.3, 0.26, 0.38, 1); will-change: transform;">
    <!-- Front -->
    <span class={`cube-front absolute inset-0 flex items-center justify-center gap-3 px-8 ${
      color === 'dark'
        ? 'bg-light-accent dark:bg-white text-white dark:text-black'
        : 'bg-transparent border border-light-border dark:border-dark-border text-light-accent dark:text-white'
    }`} style="backface-visibility: visible;">
      <span class="text-xs font-mono tracking-[0.1em] uppercase">{label}</span>
      <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </span>
    <!-- Back -->
    <span class={`cube-back absolute inset-0 flex items-center justify-center gap-3 px-8 ${
      color === 'dark'
        ? 'bg-white text-black'
        : 'bg-light-accent dark:bg-white text-white dark:text-black'
    }`} style="transform: rotateX(90deg) translateZ(28px); backface-visibility: hidden;">
      <span class="text-xs font-mono tracking-[0.1em] uppercase">{backLabel || label}</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
      </svg>
    </span>
  </span>
</a>

<style>
  a:hover > .cube-inner {
    transform: rotateX(-90deg);
  }
  @media (prefers-reduced-motion: reduce) {
    a > .cube-inner {
      transition: none !important;
    }
    a:hover > .cube-inner {
      transform: none !important;
    }
  }
</style>
