      { name: 'Kubernetes', src: 'https://api.iconify.design/logos:kubernetes.svg' },
      { name: 'Terraform', src: 'https://api.iconify.design/logos:terraform-icon.svg' },
      { name: 'Linux', src: 'https://api.iconify.design/simple-icons:linux.svg?color=333333', darkSrc: 'https://api.iconify.design/logos:linux-tux.svg' },
      { name: 'Git', src: 'https://api.iconify.design/logos:git-icon.svg' },
      { name: 'GitHub', src: 'https://api.iconify.design/simple-icons:github.svg?color=333333', darkSrc: 'https://api.iconify.design/logos:github-icon.svg' },
      { name: 'GitHub Actions', src: 'https://api.iconify.design/simple-icons:githubactions.svg?color=333333', darkSrc: 'https://api.iconify.design/logos:github-actions.svg' },
      { name: 'Nginx', src: 'https://api.iconify.design/logos:nginx.svg' },
      { name: 'Cloudflare', src: 'https://api.iconify.design/logos:cloudflare.svg' },
