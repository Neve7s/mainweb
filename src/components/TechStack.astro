const techCategories = [
  {
    titleKey: 'tech.cat.frontend',
    direction: 'left',
    items: [
      { name: 'React', src: 'https://api.iconify.design/logos:react.svg' },
      { name: 'Next.js', src: 'https://api.iconify.design/logos:nextjs-icon.svg' },
      { name: 'Astro', src: 'https://api.iconify.design/logos:astro-icon.svg' },
      { name: 'Vue', src: 'https://api.iconify.design/logos:vue.svg' },
      { name: 'Svelte', src: 'https://api.iconify.design/logos:svelte-icon.svg' },
      { name: 'Tailwind CSS', src: 'https://api.iconify.design/logos:tailwindcss-icon.svg' },
      { name: 'JavaScript', src: 'https://api.iconify.design/logos:javascript.svg' },
      { name: 'TypeScript', src: 'https://api.iconify.design/logos:typescript-icon.svg' },
      { name: 'HTML5', src: 'https://api.iconify.design/logos:html-5.svg' },
      { name: 'CSS3', src: 'https://api.iconify.design/logos:css-3.svg' },
