      { name: 'Python', src: 'https://api.iconify.design/logos:python.svg' },
      { name: 'Django', src: 'https://api.iconify.design/logos:django-icon.svg' },
      { name: 'Laravel', src: 'https://api.iconify.design/logos:laravel.svg' },
      { name: 'PHP', src: 'https://api.iconify.design/logos:php.svg' },
      { name: 'Express', src: 'https://api.iconify.design/simple-icons:express.svg?color=555555', darkSrc: 'https://api.iconify.design/simple-icons:express.svg?color=888888' },
      { name: 'FastAPI', src: 'https://api.iconify.design/logos:fastapi-icon.svg' },
      { name: 'Flask', src: 'https://api.iconify.design/simple-icons:flask.svg?color=555555', darkSrc: 'https://api.iconify.design/simple-icons:flask.svg?color=888888' },
      { name: '.NET', src: 'https://api.iconify.design/logos:dotnet.svg' },
    ]
  },
  {
    titleKey: 'tech.cat.databases',
    direction: 'left',
    items: [
      { name: 'MongoDB', src: 'https://api.iconify.design/logos:mongodb-icon.svg' },
      { name: 'PostgreSQL', src: 'https://api.iconify.design/logos:postgresql.svg' },
      { name: 'MySQL', src: 'https://api.iconify.design/logos:mysql-icon.svg' },
      { name: 'Supabase', src: 'https://api.iconify.design/logos:supabase-icon.svg' },
      { name: 'Redis', src: 'https://api.iconify.design/logos:redis.svg' },
      { name: 'Firebase', src: 'https://api.iconify.design/logos:firebase.svg' },
      { name: 'Elasticsearch', src: 'https://api.iconify.design/logos:elasticsearch.svg' },
      { name: 'SQLite', src: 'https://api.iconify.design/logos:sqlite.svg' },
    ]
  },
  {
    titleKey: 'tech.cat.ai',
    direction: 'right',
    items: [
      { name: 'n8n', src: 'https://api.iconify.design/simple-icons:n8n.svg?color=ea4b71' },
      { name: 'OpenAI', src: 'https://api.iconify.design/simple-icons:openai.svg?color=412991', darkSrc: 'https://api.iconify.design/logos:openai-icon.svg' },
      { name: 'Anthropic', src: 'https://api.iconify.design/simple-icons:anthropic.svg?color=d97757', darkSrc: 'https://api.iconify.design/logos:anthropic-icon.svg' },
      { name: 'LangChain', src: 'https://api.iconify.design/simple-icons:langchain.svg?color=333333', darkSrc: 'https://api.iconify.design/simple-icons:langchain.svg?color=c0c0c0' },
      { name: 'Hugging Face', src: 'https://api.iconify.design/logos:hugging-face-icon.svg' },
      { name: 'CrewAI', src: 'https://api.iconify.design/simple-icons:crewai.svg?color=333333', darkSrc: 'https://api.iconify.design/simple-icons:crewai.svg?color=c0c0c0' },
      { name: 'Gemini', src: 'https://api.iconify.design/logos:google-gemini.svg' },
