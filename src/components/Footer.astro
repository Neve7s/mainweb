---
import { getSettings } from '../lib/cms';
const t = Astro.props.t;
const settings = await getSettings();
const brand = (settings['brand'] ?? {}) as { name?: string };
const brandName = brand.name || 'HieysoN';
const contact = (settings['contact'] ?? {}) as { email?: string; phoneDisplay?: string; whatsappUrl?: string };
const socialLinks = ((settings['social'] ?? []) as Array<{ key: string; name: string; url: string; svg?: string; enabled?: boolean }>)
  .filter((s) => s && s.enabled !== false && s.url && s.url !== '#');
const sizedSvg = (svg: string, cls: string) => (svg || '').replace(/class="[^"]*"/, `class="${cls}"`);
const copyright = (settings['copyright'] ?? {}) as { year?: number; name?: string };
const copyYear = copyright.year ?? 2026;
const copyName = copyright.name || brandName;
---

<footer id="contact" class="border-t border-light-border dark:border-dark-border bg-light-900 dark:bg-dark-900 pt-32 pb-12 relative z-10 transition-colors duration-500">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-20 lg:gap-32 mb-32">
      <div data-animate>
        <span class="text-xs font-mono tracking-[0.2em] text-light-muted dark:text-dark-muted uppercase mb-4 block transition-colors">{t['contact.num']}</span>
        <h2 class="text-5xl xl:text-7xl font-display font-bold uppercase tracking-tighter mb-8 text-light-accent dark:text-white transition-colors">
          <span>{t['contact.title_1']} </span><br>
          <span class="text-light-muted dark:text-dark-muted transition-colors">{t['contact.title_2']}</span>
        </h2>
        <a href={`mailto:${contact.email}`}
          class="no-underline inline-flex items-center gap-4 text-xl font-mono text-light-accent dark:text-white hover:text-gray-500 dark:hover:text-gray-400 transition-colors group">
          <span>{contact.email}</span>
          <svg class="w-5 h-5 group-hover:translate-x-2 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" /></svg>
        </a>
      </div>

      <div data-animate>
        <form id="contact-form" class="space-y-8" novalidate
          data-success={t['contact.success']} data-error={t['contact.error']} data-sending={t['contact.sending']}>
          <div class="relative">
            <input type="text" id="name"
              class="w-full bg-transparent border-b border-light-border dark:border-dark-border py-4 text-light-accent dark:text-white font-mono text-sm focus:outline-none focus:border-transparent dark:focus:border-transparent transition-colors peer placeholder-transparent"
              placeholder={t['contact.placeholder.name']}>
            <label for="name"
              class="absolute left-0 top-4 text-light-muted dark:text-dark-muted font-mono text-xs uppercase tracking-[0.1em] transition-all duration-300 peer-focus:-top-2 peer-focus:text-[10px] peer-focus:text-light-accent dark:peer-focus:text-white peer-[:not(:placeholder-shown)]:-top-2 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-light-accent dark:peer-[:not(:placeholder-shown)]:text-white pointer-events-none">{t['contact.placeholder.name']}</label>
            <span class="absolute bottom-0 left-0 h-[1px] w-0 bg-light-accent dark:bg-white transition-all duration-500 peer-focus:w-full"></span>
          </div>
          <div class="relative">
            <input type="email" id="email"
              class="w-full bg-transparent border-b border-light-border dark:border-dark-border py-4 text-light-accent dark:text-white font-mono text-sm focus:outline-none focus:border-transparent dark:focus:border-transparent transition-colors peer placeholder-transparent"
              placeholder={t['contact.placeholder.email']}>
            <label for="email"
              class="absolute left-0 top-4 text-light-muted dark:text-dark-muted font-mono text-xs uppercase tracking-[0.1em] transition-all duration-300 peer-focus:-top-2 peer-focus:text-[10px] peer-focus:text-light-accent dark:peer-focus:text-white peer-[:not(:placeholder-shown)]:-top-2 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-light-accent dark:peer-[:not(:placeholder-shown)]:text-white pointer-events-none">{t['contact.placeholder.email']}</label>
            <span class="absolute bottom-0 left-0 h-[1px] w-0 bg-light-accent dark:bg-white transition-all duration-500 peer-focus:w-full"></span>
          </div>
          <div class="relative">
            <textarea id="message" rows="1"
              class="w-full bg-transparent border-b border-light-border dark:border-dark-border py-4 text-light-accent dark:text-white font-mono text-sm focus:outline-none focus:border-transparent dark:focus:border-transparent transition-colors peer placeholder-transparent resize-none overflow-hidden min-h-[50px] max-h-[150px]"
              placeholder={t['contact.placeholder.msg']}></textarea>
            <label for="message"
              class="absolute left-0 top-4 text-light-muted dark:text-dark-muted font-mono text-xs uppercase tracking-[0.1em] transition-all duration-300 peer-focus:-top-2 peer-focus:text-[10px] peer-focus:text-light-accent dark:peer-focus:text-white peer-[:not(:placeholder-shown)]:-top-2 peer-[:not(:placeholder-shown)]:text-[10px] peer-[:not(:placeholder-shown)]:text-light-accent dark:peer-[:not(:placeholder-shown)]:text-white pointer-events-none">{t['contact.placeholder.msg']}</label>
            <span class="absolute bottom-0 left-0 h-[1px] w-0 bg-light-accent dark:bg-white transition-all duration-500 peer-focus:w-full"></span>
          </div>
          <!-- Honeypot anti-spam (los humanos no lo ven ni lo llenan) -->
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" aria-hidden="true"
            class="absolute -left-[9999px] opacity-0 h-0 w-0">
          <div class="relative overflow-hidden w-full">
            <canvas class="spark-btn-canvas absolute inset-0 w-full h-full pointer-events-none z-10"></canvas>
            <button type="submit"
              class="relative z-20 w-full border border-light-border dark:border-dark-border bg-transparent text-light-accent dark:text-white font-mono text-xs uppercase tracking-[0.2em] py-5 hover:bg-light-accent hover:text-light-900 dark:hover:bg-white dark:hover:text-black transition-colors flex justify-center items-center gap-3">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8" /></svg>
              <span>{t['contact.btn']}</span>
            </button>
          </div>
          <p id="contact-status" class="font-mono text-xs tracking-wider min-h-[1.25rem]" aria-live="polite"></p>
        </form>
      </div>
    </div>

    <!-- Footer bottom -->
    <div class="border-t border-light-border dark:border-dark-border pt-8 flex flex-col md:flex-row justify-between items-center gap-6 transition-colors duration-500">
      <div class="flex flex-col gap-2">
        <p class="text-light-muted dark:text-dark-muted font-mono text-[10px] uppercase tracking-[0.2em] transition-colors">&copy; {copyYear} {copyName}. {t['footer.rights']}</p>
        <div class="flex gap-4 text-light-muted dark:text-dark-muted font-mono text-[10px] uppercase tracking-[0.1em]">
          <a href="/privacidad" class="no-underline hover:text-light-accent dark:hover:text-white transition-colors">Privacidad</a>
          <span>|</span>
          <a href="/terminos" class="no-underline hover:text-light-accent dark:hover:text-white transition-colors">Terminos</a>
          <span>|</span>
          <a href="/cookies" class="no-underline hover:text-light-accent dark:hover:text-white transition-colors">Cookies</a>
        </div>
      </div>
      <div class="flex gap-8 items-center">
        <div class="flex gap-6 flex-wrap">
          {socialLinks.map(link => (
            <a href={link.url} class="no-underline text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white transition-colors" title={link.name} set:html={sizedSvg(link.svg ?? '', 'w-5 h-5 fill-current')} />
          ))}
        </div>
        <div class="h-4 w-[1px] bg-light-border dark:bg-dark-border"></div>
        <div class="flex gap-8">
          <a href={contact.whatsappUrl} class="no-underline text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white transition-colors" title="WhatsApp">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" /></svg>
          </a>
          <a href={`mailto:${contact.email}`} class="no-underline text-light-muted dark:text-dark-muted hover:text-light-accent dark:hover:text-white transition-colors" title="Email">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  const contactForm = document.getElementById('contact-form') as HTMLFormElement | null;
  if (contactForm) {
    const statusEl = document.getElementById('contact-status');
    const submitBtn = contactForm.querySelector('button[type="submit"]');
    const apiBase = import.meta.env.PUBLIC_API_URL || 'http://localhost:3001';
    const baseCls = 'font-mono text-xs tracking-wider min-h-[1.25rem] ';
    const setStatus = (key: 'sending' | 'ok' | 'error') => {
      if (!statusEl) return;
      const msg =
        key === 'ok' ? contactForm.dataset.success
        : key === 'error' ? contactForm.dataset.error
        : contactForm.dataset.sending;
      statusEl.textContent = msg || '';
      statusEl.className = baseCls + (
        key === 'ok' ? 'text-emerald-600 dark:text-emerald-400'
        : key === 'error' ? 'text-red-600 dark:text-red-400'
        : 'text-light-muted dark:text-dark-muted'
      );
    };
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const payload = {
        name: (document.getElementById('name') as HTMLInputElement | null)?.value.trim() || '',
        email: (document.getElementById('email') as HTMLInputElement | null)?.value.trim() || '',
        message: (document.getElementById('message') as HTMLTextAreaElement | null)?.value.trim() || '',
        company: (document.getElementById('company') as HTMLInputElement | null)?.value || '',
        lang: document.documentElement.lang === 'en' ? 'en' : 'es',
        source: 'footer',
      };
      setStatus('sending');
      submitBtn?.setAttribute('disabled', '');
      try {
        const res = await fetch(`${apiBase}/api/contact`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!res.ok) throw new Error(`status ${res.status}`);
        setStatus('ok');
        contactForm.reset();
      } catch {
        setStatus('error');
      } finally {
        submitBtn?.removeAttribute('disabled');
      }
    });
  }
</script>
