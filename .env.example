# Variables de entorno — HieysoN Web (app Astro + Hono + Postgres)
# Copia a `.env` para desarrollo local. `.env` NUNCA se commitea (ya está en .gitignore).
# En Coolify estas mismas keys se cargan como variables del servicio (api / web).

# --- Base de datos: tu PostgreSQL LOCAL en dev; el externo en Coolify (prod) ---
DATABASE_URL=postgres://usuario:password@localhost:5432/hieyson

# --- API / Web ---
API_URL=http://localhost:3001
PUBLIC_SITE_URL=http://localhost:4321
NODE_ENV=development
CORS_ORIGIN=http://localhost:4321

# --- Auth admin (/admin) ---
JWT_SECRET=cambia-esto-por-uno-largo-min-32-chars
ADMIN_EMAIL=admin@hieyson.com
ADMIN_PASSWORD=solo-se-usa-en-el-primer-arranque-luego-se-rota

# --- Storage: local (dev) | cloudinary (prod) ---
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=hieyson

# --- Chatbot NEURO (NVIDIA, endpoint POST /api/chat en el backend) ---
NVIDIA_API_KEY=nvapi-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
