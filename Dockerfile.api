# syntax=docker/dockerfile:1
# API Hono (prod). Se refina en Task 17; funcional desde Task 4.
FROM node:22-alpine AS deps
WORKDIR /app/api
COPY api/package.json ./
RUN npm install --omit=dev

FROM node:22-alpine AS build
WORKDIR /app/api
COPY --from=deps /app/api/node_modules ./node_modules
COPY api/ ./
RUN npm install && npm run build

FROM node:22-alpine AS runner
WORKDIR /app/api
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --from=build /app/api/dist ./dist
COPY --from=build /app/api/package.json ./package.json
COPY --from=build /app/api/entrypoint.sh ./entrypoint.sh
COPY --from=build /app/api/drizzle ./drizzle
RUN npm install --omit=dev && chmod +x entrypoint.sh && chown -R app:app /app/api
USER app
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3001/health || exit 1
ENTRYPOINT ["./entrypoint.sh"]
