# syntax=docker/dockerfile:1
# API Hono (prod). Migra sola al arrancar vía entrypoint.sh (idempotente).
FROM node:22-alpine AS deps
WORKDIR /app/api
COPY api/package.json api/package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev

FROM node:22-alpine AS build
WORKDIR /app/api
COPY --from=deps /app/api/node_modules ./node_modules
COPY api/ ./
# seed.ts importa los JSON semilla del front (../../src/data) — copiarlos a su ruta relativa
COPY src/data /app/src/data
RUN npm install && npm run build

FROM node:22-alpine AS runner
WORKDIR /app/api
ENV NODE_ENV=production
RUN addgroup -S app && adduser -S app -G app
COPY --chown=app:app --from=build /app/api/dist ./dist
COPY --chown=app:app api/package.json api/package-lock.json* ./
COPY --chown=app:app --from=build /app/api/entrypoint.sh ./entrypoint.sh
COPY --chown=app:app --from=build /app/api/drizzle ./drizzle
COPY --chown=app:app --from=build /app/src/data /app/src/data
RUN (npm ci --omit=dev || npm install --omit=dev) && npm cache clean --force && chmod +x entrypoint.sh
USER app
EXPOSE 3001
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1:3001/health || exit 1
ENTRYPOINT ["./entrypoint.sh"]
